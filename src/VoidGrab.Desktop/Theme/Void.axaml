<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Void palette, matching the Windows build.

        This layers on top of Fluent's dark variant rather than re-templating
        every control the way the WPF head does. Two reasons: Fluent's dark
        defaults are already close, and a hand-rolled template that renders
        subtly wrong is much harder to justify on a platform I cannot see. What
        is styled here is what carries the identity — panels, accents, readouts,
        buttons — and the rest is left to look native.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="CanvasColor">#060A15</Color>
            <Color x:Key="AccentColor">#00D8EF</Color>
            <Color x:Key="FlareColor">#B47DFF</Color>

            <SolidColorBrush x:Key="Canvas">#060A15</SolidColorBrush>
            <SolidColorBrush x:Key="Surface">#0D1320</SolidColorBrush>
            <SolidColorBrush x:Key="Surface2">#151D2B</SolidColorBrush>
            <SolidColorBrush x:Key="Line">#262F40</SolidColorBrush>
            <SolidColorBrush x:Key="LineStrong">#435169</SolidColorBrush>
            <SolidColorBrush x:Key="Ink">#F1F6FC</SolidColorBrush>
            <SolidColorBrush x:Key="InkSoft">#C8D2DC</SolidColorBrush>
            <SolidColorBrush x:Key="Muted">#95A1B0</SolidColorBrush>
            <SolidColorBrush x:Key="Accent">#00D8EF</SolidColorBrush>
            <SolidColorBrush x:Key="Flare">#B47DFF</SolidColorBrush>
            <SolidColorBrush x:Key="Success">#4ADE80</SolidColorBrush>
            <SolidColorBrush x:Key="Danger">#FF6B6B</SolidColorBrush>
            <SolidColorBrush x:Key="OnAccent">#06121A</SolidColorBrush>

            <LinearGradientBrush x:Key="NeonFill" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00D8EF" Offset="0" />
                <GradientStop Color="#B47DFF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NeonSeam" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#0000D8EF" Offset="0" />
                <GradientStop Color="#00D8EF" Offset="0.25" />
                <GradientStop Color="#B47DFF" Offset="0.6" />
                <GradientStop Color="#00B47DFF" Offset="1" />
            </LinearGradientBrush>

            <!--
                Fluent reads its own accent from these three. Overriding them is
                what turns every stock control's highlight, caret and selection
                the same cyan, without touching a single template.
            -->
            <SolidColorBrush x:Key="SystemAccentColorLight1">#00D8EF</SolidColorBrush>
            <SolidColorBrush x:Key="SystemAccentColorDark1">#00B4C9</SolidColorBrush>
            <Color x:Key="SystemAccentColor">#00D8EF</Color>

            <FontFamily x:Key="MonoFont">ui-monospace, SF Mono, Menlo, Cascadia Mono, Consolas, monospace</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ======================================================== Text ===== -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A mono readout: labels, counts, states, file names. -->
    <Style Selector="TextBlock.readout">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="TextBlock.strong">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ======================================================== Panels === -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- ======================================================== Buttons == -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource NeonFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--
        Avalonia's Fluent button paints its own background for pointer states
        from inside the template, so the class-level Background above is not
        enough on its own — these reach into it to keep the gradient.
    -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeonFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeonFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Opacity" Value="0.86" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeonFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ======================================================== Inputs === -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ======================================================== Progress = -->
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource NeonFill}" />
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="MinHeight" Value="4" />
    </Style>

</Styles>
